{
  "name": "@lua/adviser",
  "version": "0.5.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "build": "expo export --platform web",
    "sync:catalog": "node ../../tools/export-mobile-catalog.mjs",
    "export:android": "expo export --platform android --output-dir dist-android",
    "test:e2e": "npm run build:chat-fixture && playwright test",
    "build:chat-fixture": "cd tests/chat-ui && expo export --platform web --output-dir ../../dist-chat-fixture"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@pchmn/expo-material3-theme": "1.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "lucide-react-native": "1.73.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
