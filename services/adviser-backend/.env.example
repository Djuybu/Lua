# Adviser Backend Environment Configuration Example
# Do NOT commit actual secrets or API keys!

# Server configuration
PORT=8080
HOST=127.0.0.1
NODE_ENV=development

# AI Provider Configuration
# Supported AI_MODE: 'mock' | 'provider' | 'fallback_only'
AI_MODE=mock
AI_TIMEOUT_MS=5000
AI_MAX_RETRIES=1

# Optional AI Provider settings for the local launcher (AI_MODE=provider)
# AI_PROVIDER_NAME=openai
# AI_API_KEY=
# AI_MODEL=gpt-6-astra
# AI_USAGE_CAP_TOKENS=100000

# Legacy SQLite test/tooling settings (not used by npm start)
ADVISER_DB_PATH=./data/adviser.sqlite

# PostgreSQL warehouse (password belongs in the ignored .env only)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=laptop
PGUSER=postgres
PGPASSWORD=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=lua_catalog
