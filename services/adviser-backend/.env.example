# Adviser Backend Environment Configuration Example
# Do NOT commit actual secrets or API keys!

# Server configuration
PORT=8080
HOST=127.0.0.1
NODE_ENV=development

# AI Provider Configuration
# Supported AI_MODE: 'mock' | 'provider' | 'fallback_only'
AI_MODE=mock
AI_TIMEOUT_MS=5000
AI_MAX_RETRIES=1

# Optional AI Provider settings (when AI_MODE=provider in controlled sandbox)
# AI_PROVIDER_NAME=gemini
# AI_API_KEY=
# AI_MODEL=gemini-1.5-flash
# AI_USAGE_CAP_TOKENS=100000

# SQLite Persistence settings
ADVISER_DB_PATH=./data/adviser.sqlite
