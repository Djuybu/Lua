FROM node:22-bookworm-slim AS node
FROM python:3.13-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
WORKDIR /repo/services/adviser-backend
COPY services/adviser-backend/package*.json ./
RUN npm ci --omit=dev
COPY tools/data-pipeline/requirements-warehouse.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY services/adviser-backend/src ./src
COPY services/adviser-backend/scripts ./scripts
COPY tools/data-pipeline /repo/tools/data-pipeline
WORKDIR /repo/tools/data-pipeline
CMD ["python", "-m", "tests.test_warehouse_reset"]
